# Copy to `.env` for local use. Never commit `.env`.

# Public Worker URL (no secrets)
EXPO_PUBLIC_API_URL=https://cardflow-ocr.shubhamanap02.workers.dev

# Hosted privacy policy (Play Console + in-app “Open in browser”)
EXPO_PUBLIC_PRIVACY_URL=https://shy-fog-9658.shubhamanap02.workers.dev/

# Google Search Console — HTML-tag verification for the privacy Worker homepage only
# From Search Console → HTML tag method, copy ONLY the content="…" value (not the full <meta> tag)
# Then: node server/build-privacy-worker.cjs → paste server/privacy-pages-worker.js into Worker shy-fog-9658 → Deploy
# GOOGLE_SITE_VERIFICATION=

# Optional support / privacy contact email (shown in Settings + legal copy)
EXPO_PUBLIC_SUPPORT_EMAIL=shubhamanap01@gmail.com

# Supabase Auth (Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only secret — never ship in the app / never commit / never EXPO_PUBLIC_
# Project Settings → API → service_role (Reveal)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key


# Allow free local Pro unlock (preview/dev only — must be 0/absent in production)
# EXPO_PUBLIC_ALLOW_LOCAL_PRO=1

# AdMob — use Google sample IDs locally; set real IDs on EAS production
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXX~YYYY
# EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-XXXX~YYYY
# EXPO_PUBLIC_ADMOB_BANNER_ID=
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=
# EXPO_PUBLIC_ADMOB_REWARDED_ID=

# DO NOT put Gemini / OCR_API_KEY here — only on Cloudflare Worker
# Optional shared gate between app and Worker (set same value as Worker secret OCR_CLIENT_KEY)
# EXPO_PUBLIC_OCR_CLIENT_KEY=generate-a-long-random-string

# OpenAI API Key for high-accuracy business card scanning and intelligent field extraction
# Add your key here: https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here
