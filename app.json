{
  "expo": {
    "name": "CardFlow",
    "slug": "CardFlow",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cardflow",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF8FF",
    "android": {
      "package": "com.shubhamanap.cardflow",
      "versionCode": 3,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shubhamanap.cardflow"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563EB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CardFlow to import business cards from your photo library.",
          "cameraPermission": "Allow CardFlow to scan business cards with your camera."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ac58b341-9ca1-4e20-8556-7cc5c1a18ea4"
      }
    },
    "owner": "shubhamanap",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ac58b341-9ca1-4e20-8556-7cc5c1a18ea4"
    }
  }
}
